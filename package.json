{
  "name": "rubiks-cube-3d-solver",
  "version": "1.0.0",
  "description": "Interactive 3D Rubik's Cube with step-by-step solver and beginner tutorial",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs --dev",
    "electron:build": "vite build && electron-packager . RubiksCubeStudio --platform=win32 --arch=x64 --out=release --overwrite --prune=true",
    "electron:build:win": "vite build && electron-packager . RubiksCubeStudio --platform=win32 --arch=x64 --out=release --overwrite --prune=true",
    "electron:build:linux": "vite build && electron-packager . RubiksCubeStudio --platform=linux --arch=x64 --out=release --overwrite --prune=true",
    "electron:build:all": "vite build && electron-packager . RubiksCubeStudio --platform=win32,linux --arch=x64 --out=release --overwrite --prune=true",
    "android:sync": "vite build && cap sync android",
    "android:build": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "cubejs": "^1.3.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-packager": "^17.1.2",
    "vite": "^5.0.12"
  }
}
